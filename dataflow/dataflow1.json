{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Json1",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Parquet1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "flatten1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as integer,",
				"          name as string,",
				"          address as (city as string, zip as string),",
				"          orders as (orderId as integer, amount as integer)[]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'singleDocument') ~> source1",
				"source1 foldDown(unroll(orders),",
				"     mapColumn(",
				"          id,",
				"          name,",
				"          address,",
				"          city = address.city,",
				"          zip = address.zip,",
				"          orders,",
				"          orderId = orders.orderId,",
				"          amount = orders.amount",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"flatten1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {_id} as string,",
				"          index as long,",
				"          guid as string,",
				"          isActive as boolean,",
				"          balance as string,",
				"          picture as string,",
				"          age as long,",
				"          eyeColor as string,",
				"          name as string,",
				"          gender as string,",
				"          company as string,",
				"          email as string,",
				"          phone as string,",
				"          address as string,",
				"          about as string,",
				"          registered as string,",
				"          latitude as double,",
				"          longitude as double,",
				"          greeting as string,",
				"          favoriteFruit as string",
				"     ),",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}