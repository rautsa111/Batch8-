					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select * from watermarktable",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_INCREMENTAL_SRC",
						"type": "DatasetReference"
